{
  "name": "Invoice Generator",
  "short_name": "Invoices",
  "description": "Make invoices and quotes in your browser. Nothing is uploaded.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#dfe3dc",
  "theme_color": "#dfe3dc",
  "icons": [
    {
      "src": "favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "id": "./",
  "lang": "en-ZA",
  "categories": [
    "business",
    "finance",
    "productivity"
  ],
  "shortcuts": [
    {
      "name": "New invoice",
      "short_name": "Invoice",
      "description": "Start a new invoice",
      "url": "./?new=invoice",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New quote",
      "short_name": "Quote",
      "description": "Start a new quote",
      "url": "./?new=quote",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/wide-light.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "A tax invoice with the ledger of saved invoices beside it"
    },
    {
      "src": "screenshots/wide-dark.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "The same invoice in dark mode"
    },
    {
      "src": "screenshots/narrow-invoice.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Creating an invoice on a phone"
    },
    {
      "src": "screenshots/narrow-ledger.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "The ledger on a phone, showing what is outstanding and overdue"
    }
  ]
}
